<Window x:Class="IpCalc.MainWindow" mc:Ignorable="d"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IpCalc"
        xmlns:localcmd="clr-namespace:IpCalc.Commands"
        xmlns:i="http://microsoft.com"
        
        xmlns:vm="clr-namespace:IpCalc.ViewModel"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Калькулятор IP" 
        Height="450" 
        Width="500"
        AllowsTransparency="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        >
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            ResizeBorderThickness="4"
            GlassFrameThickness="-1"
            CornerRadius="0"
            />
    </WindowChrome.WindowChrome>
        
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
  
    <Grid>
        
        <!--#region GLOBAL MARKUP DON'T MODIFY -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>    <!--0 Зона перетаскивания-->
            <RowDefinition Height="32"/>    <!--1 Заголовок-->
            <RowDefinition Height="24"/>    <!--2 Интервал-->
            <RowDefinition Height="20"/>    <!--3 Текст IP-->
            <RowDefinition Height="12"/>    <!--4 Интервал-->
            <RowDefinition Height="32"/>    <!--5 Поле для IP-->
            <RowDefinition Height="12"/>    <!--6 Интервал-->
            <RowDefinition Height="20"/>    <!--7 Текст Маска-->
            <RowDefinition Height="12"/>    <!--8 Интервал-->
            <RowDefinition Height="32"/>    <!--9 Поле маски-->
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->
        
        <!--#region 0 Зона перетаскивания -->
        <Grid Grid.Row="0" 
              Grid.Column="0" 
              Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <!-- Свернуть -->
                <Button Content="0" FontFamily="Marlett" Width="46" Height="32" Background="Transparent" BorderThickness="0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <localcmd:MinimizeWindowAction/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>

                <!-- Развернуть -->
                <Button Content="1" FontFamily="Marlett" Width="46" Height="32" Background="Transparent" BorderThickness="0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <localcmd:MaximizeWindowAction/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>

                <!-- Закрыть -->
                <Button Content="r" FontFamily="Marlett" Width="46" Height="32" Background="Transparent" BorderThickness="0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <localcmd:CloseWindowAction/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>

            </StackPanel>
        </Grid>

        <!--#endregion-->

        <!--#region 1 Заголовок -->
        <TextBlock Grid.Row="1" 
                   Grid.Column="1" 
                   Text="Калькулятор IP" 
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   />
        <!--#endregion-->

        <!--#region 3 Текст IP -->
        <TextBlock Grid.Row="3" 
                   Grid.Column="1" 
                   Text="IP"  
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   />
        <!--#endregion-->

        <!--#region 5 Поле для IP -->
        <Grid Grid.Row="5" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="173"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox  Grid.Column="0" InputScope="Url"/>
        </Grid>
        <!--#endregion-->

        <!--#region 7 Текст Маска -->
        <TextBlock Grid.Row="7" 
                   Grid.Column="1" 
                   Text="Маска" 
                   Style="{StaticResource BodyStrongTextBlockStyle}"
        />
        <!--#endregion-->

        <!--#region 9 Поле маски -->
        <Grid Grid.Row="9" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="153"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox  Grid.Column="0"/>
        </Grid>
        <!--#endregion-->


    </Grid>
</Window>
