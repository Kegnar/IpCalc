<Window x:Class="IpCalc.MainWindow" mc:Ignorable="d"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IpCalc"
        xmlns:vm="clr-namespace:IpCalc.ViewModel"
        Title="MainWindow" Height="450" Width="500"
        ResizeMode="CanMinimize"
        >
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Калькулятор IP" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,32,0,0"/>
        
        <TextBlock Grid.Row="1" Grid.Column="1" Text="IP"  Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBox Grid.Row="2" Grid.Column="1"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="Маска" Style="{StaticResource BodyStrongTextBlockStyle}"/>

       
    </Grid>
</Window>
